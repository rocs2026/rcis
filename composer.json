{
    "name": "rocs/rcis",
    "description": "RCIS Account Management System",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "scripts": {
        "checkstyle": "@php vendor/bin/phpcs --standard=phpcs.xml",
        "check": [
            "@composer validate",
            "@checkstyle"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
